<!doctype html>
<%!-- color-scheme: lets light-dark() colors (e.g. highlighted code) follow the system
light/dark mode, like the DSFR "system" scheme --%>
<html lang="fr" data-fr-scheme="system" style="color-scheme: light dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%!-- Beta: must not be indexed (robots.txt alone doesn't prevent it) --%>
    <meta name="robots" content="noindex, nofollow" />
    <title>{@title} - normes.transport.data.gouv.fr v2 (bêta)</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@gouvfr/dsfr@1.15.3/dist/dsfr.min.css"
    />
    <style>
      /* Heading, figure, and table numbering — scoped to page content */
      .autonumbering { counter-reset: h1 figure table; }

      .autonumbering h1 { counter-reset: h2; }
      .autonumbering h2 { counter-reset: h3; }
      .autonumbering h3 { counter-reset: h4; }

      .autonumbering h1::before { counter-increment: h1; content: counter(h1) ". "; }
      .autonumbering h2::before { counter-increment: h2; content: counter(h1) "." counter(h2) ". "; }
      .autonumbering h3::before { counter-increment: h3; content: counter(h1) "." counter(h2) "." counter(h3) ". "; }
      .autonumbering h4::before { counter-increment: h4; content: counter(h1) "." counter(h2) "." counter(h3) "." counter(h4) ". "; }

      /* Figure numbering — img followed by <em> caption */
      .autonumbering img + em {
        /* Required to "flush" the legend below the figure. */
        display: block;
      }
      .autonumbering img + em::before {
        counter-increment: figure;
        content: 'Figure ' counter(figure) ' : ';
      }

      /* Table numbering */
      .autonumbering .fr-table caption::before {
        counter-increment: table;
        content: 'Table ' counter(table) ' : ';
      }
    </style>
  </head>
  <body>
    <div class="fr-notice fr-notice--warning">
      <div class="fr-container">
        <div class="fr-notice__body">
          <p>
            <span class="fr-notice__title">Version bêta</span>
            <span class="fr-notice__desc">Future v2 en construction, la version actuelle reste</span>
            <a class="fr-notice__link" href="https://normes.transport.data.gouv.fr">
              normes.transport.data.gouv.fr
            </a>
          </p>
        </div>
      </div>
    </div>

    <header role="banner" class="fr-header">
      <div class="fr-header__body">
        <div class="fr-container">
          <div class="fr-header__body-row">
            <div class="fr-header__brand fr-enlarge-link">
              <div class="fr-header__brand-top">
                <div class="fr-header__logo">
                  <p class="fr-logo">République<br />Française</p>
                </div>
              </div>
              <div class="fr-header__service">
                <a href={@root <> "index.html"} title="Accueil - normes.transport.data.gouv.fr v2">
                  <p class="fr-header__service-title">
                    normes.transport.data.gouv.fr
                    <span class="fr-badge fr-badge--sm fr-badge--green-emeraude">v2 bêta</span>
                  </p>
                </a>
                <p class="fr-header__service-tagline">Profils France NeTEx et SIRI</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <DSFR.table_of_content tree={assigns[:toc_tree]} title="Table des matières" />

    <% extra_class =
      if assigns[:autonumbering] do
        "autonumbering"
      end %>

    <main id="main" class={"fr-container fr-my-6w #{extra_class}"}>
      {Phoenix.HTML.raw(@content)}
    </main>

    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/@gouvfr/dsfr@1.15.3/dist/dsfr.module.min.js"
    >
    </script>
  </body>
</html>
