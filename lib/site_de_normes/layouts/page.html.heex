<!doctype html>
<%!-- color-scheme: lets light-dark() colors (e.g. highlighted code) follow the system
light/dark mode, like the DSFR "system" scheme --%>
<html lang="fr" data-fr-scheme="system" style="color-scheme: light dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%!-- Beta: must not be indexed (robots.txt alone doesn't prevent it) --%>
    <meta name="robots" content="noindex, nofollow" />
    <title>{@title} - normes.transport.data.gouv.fr v2 (bêta)</title>
    <%!-- The DSFR dark theme only applies with data-fr-theme="dark", which the DSFR JS (a
    module, so run after the first paint) sets from data-fr-scheme="system": set it before,
    to avoid showing the light theme first --%>
    <script>
      if (matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.setAttribute("data-fr-theme", "dark")
      }
    </script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@gouvfr/dsfr@1.15.3/dist/dsfr.min.css"
    />
    <%!-- The fr-icon-* classes are not in dsfr.min.css (chevron of the version menu) --%>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@gouvfr/dsfr@1.15.3/dist/utility/icons/icons-arrows/icons-arrows.min.css"
    />
    <style>
      /* Version selector: on mobile, goes below the title (which takes the full width) */
      .fr-header__body-row { flex-wrap: wrap; }
      /* Version selector: on desktop, top right of the header (DSFR aligns the content of
      fr-header__tools to the right, but only if it is a flex container) */
      .fr-header__tools { display: flex; flex-direction: column; }
      /* Menu of the versions: below its button, as wide as its content */
      .version-menu .fr-nav__item { position: relative; }
      .version-menu .fr-nav__item::before { content: none; }
      .version-menu .fr-menu__list { width: auto; min-width: 100%; }

      /* Breadcrumb, ending with the source file of the page, in the style of its links */
      .page-context {
        background-color: var(--background-alt-grey);
        padding: 1rem 0;
      }
      .page-context .fr-breadcrumb { margin: 0; }
      /* Same vertical offset as the DSFR breadcrumb links */
      .fr-breadcrumb__after { vertical-align: 0.25rem; }
      .fr-breadcrumb__after a { color: inherit; }

      /* Pages of the version: the current one in bold, without underline */
      .version-pages [aria-current="page"] {
        font-weight: bold;
        background-image: none;
      }

      /* Heading, figure, and table numbering — scoped to page content */
      .autonumbering { counter-reset: h1 figure table; }

      .autonumbering h1 { counter-reset: h2; }
      .autonumbering h2 { counter-reset: h3; }
      .autonumbering h3 { counter-reset: h4; }

      .autonumbering h1::before { counter-increment: h1; content: counter(h1) ". "; }
      .autonumbering h2::before { counter-increment: h2; content: counter(h1) "." counter(h2) ". "; }
      .autonumbering h3::before { counter-increment: h3; content: counter(h1) "." counter(h2) "." counter(h3) ". "; }
      .autonumbering h4::before { counter-increment: h4; content: counter(h1) "." counter(h2) "." counter(h3) "." counter(h4) ". "; }

      /* ── Annex numbering in body ────────────────────────────────────────── */
      /* annex-h1 scope: one counter for all h1s in the annexes (A, B, C…) */
      .autonumbering .annexes { counter-reset: h1; }
      .autonumbering .annexes h1::before { content: 'Annexe ' counter(h1, upper-alpha) ' — '; }
      .autonumbering .annexes h2::before { content: counter(h1, upper-alpha) '.' counter(h2) '. '; }
      .autonumbering .annexes h3::before { content: counter(h1, upper-alpha) '.' counter(h2) '.' counter(h3) '. '; }
      .autonumbering .annexes h4::before { content: counter(h1, upper-alpha) '.' counter(h2) '.' counter(h3) '. ' counter(h4) ". "; }

      /* ── Annex numbering in ToC ─────────────────────────────────────────── */
      /* Separate counter family for annex letters (A, B, C…) in the ToC */
      /* We emulate h1, h2, h3 hierarchy via the `data-level` attributes to be able to properly number the headings. This mimics what's done for h1, h2, h3, h4 in the body. */
      .fr-summary .annexes { counter-reset: annex1; }
      .fr-summary .annexes a[data-level="1"] { counter-reset: annex2; }
      .fr-summary .annexes a[data-level="2"] { counter-reset: annex3; }
      .fr-summary .annexes a[data-level="3"] { counter-reset: annex4; }

      .fr-summary .annexes a[data-level="1"]::before { counter-increment: annex1; content: counter(annex1, upper-alpha) '.\00a0\00a0'; }
      .fr-summary .annexes a[data-level="2"]::before { counter-increment: annex2; content: counter(annex1, upper-alpha) '.' counter(annex2) '.\00a0\00a0'; }
      .fr-summary .annexes a[data-level="3"]::before { counter-increment: annex3; content: counter(annex1, upper-alpha) '.' counter(annex2) '.' counter(annex3) '.\00a0\00a0'; }
      .fr-summary .annexes a[data-level="3"]::before { counter-increment: annex4; content: counter(annex1, upper-alpha) '.' counter(annex2) '.' counter(annex3) '.' counter(annex4) '.\00a0\00a0'; }

      /* Hide numbering for Bibliographie entries in ToC (and don't count them) */
      .fr-summary [data-hide-numbering="true"]::before {
        counter-increment: none !important;
        content: '' !important;
      }

      /* Hide numbering for Bibliographie in body */
      h1#bibliographie::before {
        content: '' !important;
      }

      /* Figure numbering — img followed by <em> caption */
      .autonumbering img + em {
        /* Required to "flush" the legend below the figure. */
        display: block;
      }
      .autonumbering img + em::before {
        counter-increment: figure;
        content: 'Figure ' counter(figure) ' : ';
      }

      /* Table numbering */
      .autonumbering .fr-table caption::before {
        counter-increment: table;
        content: 'Table ' counter(table) ' : ';
      }

      /* Dirty hack to prevent table captions to be hidden under the table.
         I don't understand why it's behaving like that. I'd be surprised it's
         a bug from the DSFR and rather a tricky misuse of it by our code. */
      .fr-table[data-fr-js-table="true"] caption {
        position: revert;
      }

      #main img[src$=".svg"] {
        width: 100%;
      }
      #main img[src$=".png"] {
        max-width: 100%;
      }

      @media (prefers-color-scheme: dark) {
        #main img[src$=".svg"],
        #main img[src$=".png"] {
          background: white;
        }
      }
    </style>
  </head>
  <body>
    <div class="fr-notice fr-notice--warning">
      <div class="fr-container">
        <div class="fr-notice__body">
          <p>
            <span class="fr-notice__title">Version bêta</span>
            <span class="fr-notice__desc">Future v2 en construction, la version actuelle reste</span>
            <a class="fr-notice__link" href="https://normes.transport.data.gouv.fr">
              normes.transport.data.gouv.fr
            </a>
          </p>
        </div>
      </div>
    </div>

    <header role="banner" class="fr-header">
      <div class="fr-header__body">
        <div class="fr-container">
          <div class="fr-header__body-row">
            <div class="fr-header__brand fr-enlarge-link">
              <div class="fr-header__brand-top">
                <div class="fr-header__logo">
                  <p class="fr-logo">République<br />Française</p>
                </div>
              </div>
              <div class="fr-header__service">
                <a href={@root} title="Accueil - normes.transport.data.gouv.fr v2">
                  <p class="fr-header__service-title">
                    normes.transport.data.gouv.fr
                    <span class="fr-badge fr-badge--sm fr-badge--green-emeraude">v2 bêta</span>
                  </p>
                </a>
                <p class="fr-header__service-tagline">Profils France NeTEx et SIRI</p>
              </div>
            </div>
            <%!-- Version selector: a button opening a menu of links (DSFR menu of the main
            navigation, opened and closed by the DSFR JS). Links rather than a <select>, which
            would change page on change (RGAA 7.4). Outside of fr-header__brand: its
            fr-enlarge-link would cover the button --%>
            <nav
              :if={assigns[:version]}
              class="fr-header__tools fr-nav version-menu fr-px-2w"
              role="navigation"
              aria-label={"Versions du profil #{@version.profile}"}
            >
              <div class="fr-nav__item">
                <button
                  type="button"
                  class="fr-btn fr-btn--tertiary fr-btn--sm fr-btn--icon-right fr-icon-arrow-down-s-line"
                  aria-expanded="false"
                  aria-controls="version-menu"
                >
                  {@version.profile} {@version.name}
                </button>
                <div class="fr-collapse fr-menu" id="version-menu">
                  <ul class="fr-menu__list">
                    <li :for={version <- @version.all}>
                      <a
                        class="fr-nav__link"
                        href={@root <> version.path <> "/"}
                        aria-current={if version.name == @version.name, do: "true"}
                      >
                        {version.name}
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <%!-- Where the page is: in the site (breadcrumb), and in the source repository --%>
    <div :if={assigns[:breadcrumb]} class="page-context">
      <div class="fr-container">
        <DSFR.breadcrumb links={@breadcrumb}>
          <span :if={assigns[:source_url]}>(source : <a href={@source_url}>{@file}</a>)</span>
        </DSFR.breadcrumb>
      </div>
    </div>

    <%!-- Simple list until a proper navigation (titles instead of files) --%>
    <nav
      :if={assigns[:version_pages]}
      class="version-pages fr-container fr-mt-4w"
      aria-labelledby="version-pages-title"
    >
      <p id="version-pages-title" class="fr-text--bold fr-mb-1w">
        {@pages_title}
        <span class="fr-badge fr-badge--warning fr-badge--sm fr-ml-1w">Navigation provisoire</span>
      </p>
      <ul>
        <li :for={page <- @version_pages}>
          <a href={@root <> page.href} aria-current={if page.href == @href, do: "page"}>
            {page.path}
          </a>
        </li>
      </ul>
    </nav>

    <DSFR.table_of_content
      tree={assigns[:toc_tree]}
      annexes={assigns[:toc_annexes]}
      title="Table des matières"
    />

    <% extra_class =
      if assigns[:autonumbering] do
        "autonumbering"
      end %>

    <main id="main" class={"fr-container fr-my-6w #{extra_class}"}>
      <.beta_alert :if={assigns[:beta]} />
      {Phoenix.HTML.raw(@content)}
    </main>

    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/@gouvfr/dsfr@1.15.3/dist/dsfr.module.min.js"
    >
    </script>
  </body>
</html>
